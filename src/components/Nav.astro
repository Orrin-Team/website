---
/**
 * The floating glass bar: wordmark left, links centre, GitHub + CTA right.
 *
 * Transparent over the hero and frosted once the page scrolls, so it never
 * draws a line across the headline. Links come from src/data/site.ts — to add
 * one, add it there.
 */
import { site, navLinks, navCta } from "../data/site";

const { pathname } = Astro.url;
const isCurrent = (link: (typeof navLinks)[number]) =>
  link.match ? pathname.startsWith(link.match) : pathname === link.href;
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="nav__brand" href="/">
      <img src="/brand/orrin-icon.png" alt="" width="24" height="24" />
      {site.name}
    </a>

    <nav class="nav__center" aria-label="Primary">
      {
        navLinks.map((l) => (
          <a
            class="nav__link"
            href={l.href}
            aria-current={isCurrent(l) ? "page" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__right">
      <a class="btn btn--text" href={site.repo} rel="noopener">GitHub</a>
      <a class="btn btn--accent" href={navCta.href}>{navCta.label}</a>
      <button
        class="nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-sheet"
        aria-label="Open menu"
        data-nav-toggle
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M2 5.5h14M2 12.5h14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="nav__sheet" id="nav-sheet" data-nav-sheet inert>
    {
      navLinks.map((l) => (
        <a
          class="nav__link"
          href={l.href}
          aria-current={isCurrent(l) ? "page" : undefined}
        >
          {l.label}
        </a>
      ))
    }
    <a class="nav__link" href={site.repo} rel="noopener">GitHub</a>
    <a class="nav__link" href={site.discord} rel="noopener">Discord</a>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const sheet = document.querySelector<HTMLElement>("[data-nav-sheet]");

  // Frost on scroll. rAF-throttled, and the threshold is deliberately small —
  // the bar should pick up its background as soon as content slides under it.
  let ticking = false;
  const sync = () => {
    nav?.classList.toggle("is-scrolled", window.scrollY > 16);
    ticking = false;
  };
  addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    },
    { passive: true },
  );
  sync();

  const setSheet = (open: boolean) => {
    if (!sheet || !toggle) return;
    sheet.classList.toggle("is-open", open);
    // `inert` while closed: the sheet animates rather than being display:none,
    // so without this its links stay in the tab order behind the page.
    sheet.toggleAttribute("inert", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };

  toggle?.addEventListener("click", () =>
    setSheet(!sheet?.classList.contains("is-open")),
  );

  addEventListener("keydown", (e) => {
    if (e.key === "Escape" && sheet?.classList.contains("is-open")) {
      setSheet(false);
      toggle?.focus();
    }
  });

  // A tap outside closes it. Without this the sheet can only be dismissed from
  // the button, which is not where a thumb goes.
  addEventListener("pointerdown", (e) => {
    if (!sheet?.classList.contains("is-open")) return;
    if (nav?.contains(e.target as Node)) return;
    setSheet(false);
  });
</script>
