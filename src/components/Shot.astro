---
/**
 * A screenshot in a glass frame.
 *
 * With no `src` it renders a labelled placeholder at the right aspect ratio,
 * rather than a broken image — so a shot you haven't captured yet doesn't
 * shift the layout when you drop it in.
 *
 * Nothing frames the image. The captures are window grabs with transparent
 * corners and their own drop shadow baked in, so a panel behind one would
 * show as a second, differently-rounded rectangle around it.
 *
 * No added browser chrome, no device frame, no tilt either: the reader
 * already has a window, and drawing them a fake one is a tell.
 */
interface Props {
  /** e.g. "/shots/Editor.webp". Omit to render the placeholder. */
  src?: string;
  /** Describes the intended subject, so it stays correct after you swap. */
  alt: string;
  /** Names the shot. Shown under a real image, or inside the placeholder.
   *  Omit it on a real image and no caption is drawn. */
  caption?: string;
  /** The file's real pixel width — reserves the aspect ratio. */
  w: number;
  /** The file's real pixel height. */
  h: number;
  /** Set on an above-the-fold shot: skips lazy-loading, raises priority. */
  priority?: boolean;
}

const { src, alt, caption, w, h, priority = false } = Astro.props;
---

<figure class="shot">
  {
    src ? (
      <img
        class="shot__img"
        src={src}
        alt={alt}
        width={w}
        height={h}
        loading={priority ? "eager" : "lazy"}
        decoding={priority ? "sync" : "async"}
        fetchpriority={priority ? "high" : "auto"}
        style={`aspect-ratio: ${w} / ${h}`}
      />
    ) : (
      <div
        class="shot__slot"
        style={`aspect-ratio: ${w} / ${h}`}
        role="img"
        aria-label={`Screenshot placeholder — ${alt}`}
      >
        <div aria-hidden="true">
          <p class="shot__slot-name">{caption}</p>
          <p class="shot__slot-hint">
            {w} × {h} · screenshot needed
          </p>
        </div>
      </div>
    )
  }
  {src && caption && <figcaption class="shot__cap">{caption}</figcaption>}
</figure>
