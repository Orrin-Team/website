---
/**
 * The meta row: wordmark, links, licence. Links come from src/data/site.ts.
 */
import { site, footer } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="foot__inner">
    <div class="foot__meta">
      <a class="foot__brand" href="/">
        <img src="/brand/orrin-icon.png" alt="" width="22" height="22" />
        {site.name}
      </a>

      <div class="foot__links">
        {
          footer.links.map((l) => (
            <a
              class="foot__link"
              href={l.href}
              rel={l.href.startsWith("http") ? "noopener" : undefined}
            >
              {l.label}
            </a>
          ))
        }
      </div>

      <span class="foot__legal">
        © {year} {site.name} Team · {site.licence}
      </span>
    </div>
  </div>
</footer>
