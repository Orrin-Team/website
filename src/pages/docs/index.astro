---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const docs = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Documentation"
  description="How to build Orrin from source, run the demo, scaffold a project with the CLI, write C# scripts, and read the generated API reference."
>
  <div class="shell shell--narrow">
    <header class="page-head">
      <h1>Documentation</h1>
      <p>
        Orrin is pre-release. These pages cover what exists on <code class="mono"
          >master</code
        > today, and say so plainly where something is still an open issue.
      </p>
    </header>

    <div class="posts">
      {
        docs.map((d) => (
          <article class="post-row pane pane--hover">
            <a class="post-row__link" href={`/docs/${d.id}/`}>
              <span class="post-row__date">
                {String(d.data.order).padStart(2, "0")}
              </span>
              <div class="post-row__text">
                <h2>{d.data.title}</h2>
                <p>{d.data.description}</p>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</Base>
