---
/**
 * The roadmap: one line running down the page, with a milestone on it at each
 * date. Content lives in src/data/roadmap.ts.
 *
 * The expanders are native <details>, so they work with no JavaScript, they're
 * keyboard-operable for free, and the browser's own find-in-page can open one
 * to reveal a match inside it.
 */
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { inline } from "../lib/inline";
import { milestones, tail, roadmapPage } from "../data/roadmap";
---

<Base
  title={roadmapPage.title}
  description="Where Orrin is going: the demo, the pre-release and 1.0, and the dates each is aimed at."
>
  <div class="shell shell--narrow">
    <header class="page-head">
      <h1>{roadmapPage.title}</h1>
      <p>{roadmapPage.lede}</p>
    </header>

    <ol class="track">
      {
        milestones.map((m) => (
          <li class="track__row">
            <details class="ms">
              <summary class="ms__head">
                <span class="ms__dot" aria-hidden="true" />
                <span class="ms__title">{m.title}</span>
                <span class="ms__when mono">{m.when}</span>
                <svg
                  class="ms__chev"
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  fill="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M3.5 5.5 7 9l3.5-3.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {m.summary && <span class="ms__sum">{m.summary}</span>}
              </summary>

              <div class="ms__body">
                {m.details?.map((d) => <p set:html={inline(d)} />)}
                {m.points && (
                  <ul class="ms__points">
                    {m.points.map((pt) => (
                      <li set:html={inline(pt)} />
                    ))}
                  </ul>
                )}
              </div>
            </details>
          </li>
        ))
      }

      <li class="track__row track__row--tail">
        <span class="ms__dot ms__dot--open" aria-hidden="true"></span>
        <span class="track__tail">{tail}</span>
      </li>
    </ol>

    <section class="closer pane pane--soft">
      <h2>{roadmapPage.closer.heading}</h2>
      <p>{roadmapPage.closer.body}</p>
      {
        roadmapPage.closer.action && (
          <a class="btn btn--glass" href={site.discord} rel="noopener">
            {roadmapPage.closer.action.label}
          </a>
        )
      }
    </section>
  </div>
</Base>
