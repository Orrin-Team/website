---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "long",
  year: "numeric",
}).format(entry.data.date);
---

<Base
  title={`${entry.data.title} — Orrin Engine`}
  description={entry.data.description}
>
  <div class="shell shell--narrow">
    <header class="page-head">
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <p class="mono muted">
        <time datetime={entry.data.date.toISOString()}>{fmt}</time> · {entry.data.author}
      </p>
    </header>

    {
      entry.data.cover && (
        <Image
          class="post-hero"
          src={entry.data.cover}
          alt={entry.data.coverAlt!}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 64rem) 944px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }

    <article class="prose post-body">
      <Content />
    </article>

    <nav class="closer" aria-label="Blog">
      <a class="tlink" href="/blog/"
        ><span aria-hidden="true">←</span> All development notes</a
      >
    </nav>
  </div>
</Base>

<style>
  .post-body {
    padding-block: var(--space-2xl);
  }
</style>
