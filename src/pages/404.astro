---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";

/** Everything there is. Edit this list, not the markup below. */
const destinations = [
  {
    href: "/docs/getting-started/",
    title: "Documentation",
    note: "Build from source, run the demo, scaffold a project, write C#.",
  },
  {
    href: "/roadmap/",
    title: "Roadmap",
    note: "Nine phases — what has shipped and what is still open.",
  },
  {
    href: "/blog/",
    title: "Blog Posts",
    note: "Progress reports, findings and stories from building the engine.",
  },
  {
    href: site.repo,
    title: "The repository",
    note: "Source, issue tracker and milestones.",
  },
];
---

<Base
  title="Page not found"
  description="That page doesn't exist. The engine is pre-release and pages move; here's where to go instead."
>
  <div class="shell shell--narrow">
    <header class="page-head">
      <h1>That page doesn't exist.</h1>
      <p>
        The site changes as the engine does, so a link may have moved or been
        renamed. Here's everything there is.
      </p>
    </header>

    <nav class="posts" aria-label="Site">
      {
        destinations.map((d, i) => (
          <article class="post-row pane pane--hover">
            <a
              class="post-row__link"
              href={d.href}
              rel={d.href.startsWith("http") ? "noopener" : undefined}
            >
              <span class="post-row__date">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="post-row__text">
                <h2>{d.title}</h2>
                <p>{d.note}</p>
              </div>
            </a>
          </article>
        ))
      }
    </nav>

    <section class="closer pane pane--soft">
      <a class="btn btn--accent" href="/">Back to the start</a>
    </section>
  </div>
</Base>
