---
/**
 * The landing page.
 *
 * There is no copy in this file — every string comes from src/data/home.ts.
 * This is the layout only: if you want to change what the page says, edit the
 * data file. If you want to change the order of the bands, edit here.
 */
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Shot from "../components/Shot.astro";
import { inline } from "../lib/inline";
import { site } from "../data/site";
import {
  hero,
  quickstart,
  showcase,
  pillars,
  features,
  status,
  closer,
} from "../data/home";
---

<Base
  title={`${site.name} Engine`}
  description={site.description}
>
  {/* ---- Hero ----------------------------------------------------------- */}
  <section class="hero shell">
    <div class="hero__grid">
      <div>
        <h1 class="hero__title reveal" style="--i:0" set:html={inline(hero.title)} />

        <p class="lede hero__lede reveal" style="--i:1">{hero.lede}</p>

        <div class="hero__actions reveal" style="--i:2">
          {
            hero.actions.map((a) => (
              <a
                class:list={["btn", a.primary ? "btn--accent" : "btn--glass"]}
                href={a.href}
                rel={a.href.startsWith("http") ? "noopener" : undefined}
              >
                {a.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="reveal" style="--i:3">
        <CodeBlock label={quickstart.label} lines={quickstart.lines} />
      </div>
    </div>
  </section>

  <div class="shell">
    {/* ---- Showcase ----------------------------------------------------- */}
    <section class="showcase band">
      <h2 class="showcase__head">{showcase.heading}</h2>
      <Shot {...showcase.shot} />
    </section>

    {/* ---- Pillars ------------------------------------------------------ */}
    <section class="band">
      <h2 class="pillars__head">{pillars.heading}</h2>
      <ul class="pillars">
        {
          pillars.items.map((it) => (
            <li class="pillar pane pane--hover">
              <img
                class="pillar__img"
                src={it.shot.src}
                alt={it.shot.alt}
                width={it.shot.w}
                height={it.shot.h}
                loading="lazy"
                decoding="async"
              />
              <div class="pillar__text">
                <h3>{it.title}</h3>
                <p>{it.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    {/* ---- Features ----------------------------------------------------- */}
    {
      features.map((f, i) => (
        <section
          class:list={[
            "feature",
            i % 2 === 1 && "feature--flip",
            !f.proof && "feature--wide",
          ]}
        >
          <div class="feature__text">
            <h2>{f.heading}</h2>
            <p>{f.body}</p>
            {f.link && (
              <a class="tlink" href={f.link.href}>
                {f.link.label} <span aria-hidden="true">→</span>
              </a>
            )}
          </div>

          {f.proof && (
            <div class="feature__proof">
              {f.proof.kind === "rows" ? (
                <div class="rows pane">
                  {f.proof.rows.map((r) => (
                    <div class="row">
                      <span class="row__k">{r.k}</span>
                      <span class="row__v">
                        {r.v}
                        {r.tag && <> <span class="tag tag--pending">{r.tag}</span></>}
                      </span>
                    </div>
                  ))}
                </div>
              ) : (
                <>
                  <Shot {...f.proof.shot} />
                  <p class="feature__note">{f.proof.note}</p>
                </>
              )}
            </div>
          )}
        </section>
      ))
    }

    {/* ---- Status ------------------------------------------------------- */}
    <section class="band">
      <div class="status pane">
        <h2>{status.heading}</h2>
        <div class="status__body">
          {status.paragraphs.map((p) => <p set:html={inline(p)} />)}
        </div>
      </div>
    </section>

    {/* ---- Closer ------------------------------------------------------- */}
    <section class="closer pane pane--soft">
      <h2>{closer.heading}</h2>
      <p set:html={inline(closer.body)} />
      {
        closer.action && (
          <a class="btn btn--accent" href={closer.action.href}>
            {closer.action.label}
          </a>
        )
      }
    </section>
  </div>
</Base>
